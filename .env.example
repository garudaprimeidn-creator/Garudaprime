# Copy to .env.local. Never commit secrets.
# Keys marked server-only must not use the VITE_ prefix.

# Auth / data platform (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app.garudaprime.id
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Web Client ID (mobile / PWA)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# WalletConnect v2
VITE_WALLETCONNECT_PROJECT_ID=

# Sidra Network
VITE_SIDRA_CHAIN_ID=97453
VITE_SIDRA_RPC_URL=https://rpc.sidrachain.com
# VITE_SIDRA_EXPLORER_API=

# GAT token (set after deploy)
# VITE_GAT_TOKEN_ADDRESS=0x...
# VITE_GAT_TOKEN_DECIMALS=18
# VITE_GAT_PRICE_USD=0

# Pay Hub API (unset = localStorage)
# VITE_PAY_HUB_API_URL=http://127.0.0.1:3000/api
# ADMIN_PAY_OPS_SECRET=
# CRON_SECRET=
# PAY_HUB_OPS_WEBHOOK_URL=
# PAY_HUB_LEDGER_MODE=hybrid
# PAY_HUB_ONCHAIN_CONTRACTS_JSON=
# PAY_HUB_RELAYER_ADDRESS=0x...
# PAY_HUB_RELAYER_PRIVATE_KEY=0x...

# Embedded wallet (server-only secrets below)
# VITE_EMBEDDED_WALLET_PROVIDER=garuda
# VITE_GARUDA_NATIVE_WALLET_ENABLED=true
# GARUDA_WALLET_ENABLED=true
# GARUDA_WALLET_MASTER_SECRET=
# GARUDA_WALLET_AUTO_ON_KYC=true
# EMBEDDED_WALLET_PROVIDER=garuda
# VITE_EMBEDDED_WALLET_DEMO=false
# RELAYER_PAYMASTER_ENABLED=false
# RELAYER_MAX_GAS_SPONSOR_PER_DAY=0.05
# GARUDA_WALLET_MAX_NATIVE_WEI=0
# VITE_PAY_HUB_MERCHANT_ID=GP-MRT-2847
# VITE_PAY_HUB_MERCHANT_NAME=Garuda Halal Mart
# VITE_PAY_HUB_MERCHANT_ADDRESS=0x...

# Contract deploy (Hardhat / contracts/)
# DEPLOYER_PRIVATE_KEY=0x...
# GAT_TREASURY_ADDRESS=0x...
# GAT_INITIAL_SUPPLY=100000000
# GAT_MAX_SUPPLY=100000000

# Ecosystem phase: 1 Sidra, 2 Garuda testnet, 3 governance, 4 mainnet (default)
VITE_ECOSYSTEM_PHASE=4

# Garuda Chain
VITE_GARUDA_CHAIN_ID=8846
VITE_GARUDA_CHAIN_STATUS=mainnet
VITE_GARUDA_CHAIN_RPC_URL=https://rpc.garudachain.id
VITE_GARUDA_CHAIN_EXPLORER=https://explorer.garudachain.id
# VITE_GARUDA_MAINNET_GAT_ADDRESS=0x...
# VITE_GARUDA_MAINNET_BRIDGE_VAULT=0x...
# VITE_GOVERNANCE_ENABLED=true
# VITE_MAINNET_MIGRATION_OPEN=false
# GARUDA_MAINNET_MINTER_PRIVATE_KEY=0x...
# GARUDA_MAINNET_GAT_ADDRESS=0x...
# VITE_GAT_BRIDGE_VAULT_ADDRESS=0x...

# Pay Hub backing EOA (do not reuse SC treasury address)
# VITE_PAY_HUB_BACKING_ADDRESS=0x...
# PROTOCOL_OWNER_ADDRESS=0x...
# PROTOCOL_OWNER_PRIVATE_KEY=0x...
# RELAYER_MAX_GAT_PER_TX=1000000
# VITE_GAT_TREASURY_ADDRESS=0x...
# REFERRAL_SC_AUTO_PAYOUT=true
# VITE_GARUDA_UTILITY_NFT_ADDRESS=0x...
# UTILITY_NFT_MINTER_PRIVATE_KEY=0x...
# VITE_GAT_FEE_ROUTER_ADDRESS=0x...
# VITE_GAT_STAKING_POOL_ADDRESS=0x...
# VITE_GAT_INVESTMENT_VAULT_ADDRESS=0x...
# PROTOCOL_ROI_POOL_GAT=10000
# PROTOCOL_STAKING_REWARDS_GAT=5000
# VITE_PROTOCOL_ONCHAIN_INVEST=true
# VITE_PROTOCOL_ONCHAIN_STAKE=true

# Bridge relayer (server-only)
# GARUDA_TESTNET_MINTER_PRIVATE_KEY=0x...
# GARUDA_TESTNET_GAT_ADDRESS=0x...
# GAT_BRIDGE_VAULT_ADDRESS=0x...

# Base Network (optional)
# VITE_ENABLE_BASE_NETWORK=true
# VITE_BASE_CHAIN_ID=8453
# VITE_BASE_RPC_URL=https://mainnet.base.org

# KYC OIDC provider (set in console for your app)
VITE_KYCPORT_API_BASE_URL=
VITE_KYCPORT_AUTHORIZE_URL=
VITE_KYCPORT_LOGIN_URL=
VITE_KYCPORT_OAUTH_ENTRY_URL=
VITE_KYCPORT_PORTAL_URL=
VITE_KYCPORT_VERIFY_URL=
VITE_KYCPORT_CLIENT_ID=
VITE_KYCPORT_REDIRECT_URI=http://localhost:5173/auth/kycport/callback
VITE_KYCPORT_SCOPES=openid profile email kyc:read kyc:write
VITE_KYCPORT_APP_NAME=Garuda Prime
VITE_KYCPORT_PARTNER_ID=garudaprime
VITE_KYCPORT_CHAIN_ID=974540
VITE_KYCPORT_NETWORK=Garuda Prime
