    "deploy:payhub-onchain": "hardhat run scripts/deploy-payhub-onchain.cjs --network sidra",
    "deploy:payment-direct": "hardhat run scripts/deploy-payment-direct.cjs --network sidra",
    "deploy:governance-validator": "hardhat run scripts/deploy-governance-validator.cjs --network sidra",
    "register:payhub-vaults": "hardhat run scripts/register-payhub-merchant-vaults.cjs --network sidra",
    "node:garuda": "hardhat node --port 9745 --hostname 0.0.0.0",
