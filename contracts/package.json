    "deploy:sidra": "hardhat run scripts/deploy-gat.cjs --network sidra",
    "mint:sidra": "hardhat run scripts/mint-gat-supply.cjs --network sidra",
    "bridge:sidra": "hardhat run scripts/deploy-bridge-vault.cjs --network sidra",
    "deploy:protocol": "hardhat run scripts/deploy-protocol.cjs --network sidra",
    "setup:protocol": "hardhat run scripts/setup-protocol.cjs --network sidra",
    "sweep:treasury": "hardhat run scripts/sweep-to-sc-treasury.cjs --network sidra",
    "sweep:treasury:dry": "SWEEP_DRY_RUN=1 hardhat run scripts/sweep-to-sc-treasury.cjs --network sidra",
    "fund:referral-bucket": "hardhat run scripts/fund-referral-bucket.cjs --network sidra",
    "fund:referral-bucket:dry": "FUND_REFERRAL_DRY_RUN=1 hardhat run scripts/fund-referral-bucket.cjs --network sidra",
    "deploy:utility-nft": "hardhat run scripts/deploy-utility-nft.cjs --network sidra",
    "audit:sc-gat": "node scripts/audit-sc-gat-balances.cjs",
    "recover:stranded": "hardhat run scripts/recover-stranded-pools.cjs --network sidra",
    "recover:stranded:dry": "SWEEP_DRY_RUN=1 hardhat run scripts/recover-stranded-pools.cjs --network sidra",
    "legacy:recover-to-owner": "hardhat run scripts/recover-legacy-gat-to-owner.cjs --network sidra",
