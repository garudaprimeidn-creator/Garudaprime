{
  "name": "garuda-prime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/write-app-version.mjs && node scripts/sync-marketing-logo.mjs && node scripts/write-apk-meta.mjs && node scripts/generate-og-share.mjs && npx tsx scripts/write-lang-registry.ts && npx tsx scripts/write-marketing-i18n.ts && vite build",
    "dev": "vite",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "contracts:install": "npm install --prefix contracts",
    "contracts:compile": "npm run compile --prefix contracts",
    "contracts:test": "npm run test --prefix contracts",
    "contracts:deploy": "npm run deploy:sidra --prefix contracts",
    "contracts:mint": "npm run mint:sidra --prefix contracts",
    "contracts:bridge": "npm run bridge:sidra --prefix contracts",
    "payhub:serve": "cd functions && npm run build && cd .. && npx firebase emulators:start --only functions",
    "payhub:serve:full": "cd functions && npm run build && cd .. && npx firebase emulators:start --only functions,firestore",
    "payhub:local-api": "npx tsx server/localDevServer.ts",
    "garuda:testnet": "node scripts/garuda-testnet.mjs",
    "garuda:bootstrap": "npm run bootstrap:garuda --prefix contracts",
    "garuda:tunnel": "cloudflared tunnel --url http://127.0.0.1:9745",
    "garuda:tunnel:ngrok": "ngrok http 9745",
    "google:oauth:logo": "node scripts/generate-google-oauth-logo.mjs",
    "logos:process-light": "node scripts/process-light-logo.mjs",
    "icons:process": "node scripts/process-app-icon.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:sync": "node scripts/process-app-icon.mjs && npm run icons:generate && node scripts/sync-marketing-logo.mjs",
    "logos:sync": "node scripts/process-light-logo.mjs && npm run icons:sync && node scripts/process-brand-auth.mjs && node scripts/generate-og-share.mjs && node scripts/generate-google-oauth-logo.mjs",
    "marketing:logos": "node scripts/sync-marketing-logo.mjs",
    "domains:check": "node scripts/check-domain-dns.mjs",
    "domains:fix": "node scripts/fix-domain-dns.mjs",
    "twa:fingerprint": "node scripts/twa-fingerprint.mjs",
    "twa:assetlinks": "node scripts/write-assetlinks.mjs",
    "twa:init": "bubblewrap init --manifest twa/twa-manifest.json --directory android",
    "apk:build": "node scripts/build-apk.mjs",
    "deploy": "node scripts/write-apk-meta.mjs && npm run build",
    "deploy:full": "JAVA_HOME=${JAVA_HOME:-/opt/homebrew/Cellar/openjdk@17/17.0.19/libexec/openjdk.jdk/Contents/Home} npm run apk:build && npm run deploy",
    "contracts:deploy-governance": "npm run deploy:governance-validator --prefix contracts",
    "contracts:deploy-payment-direct": "npm run deploy:payment-direct --prefix contracts",
    "protocol:verify": "node scripts/verify-protocol-onchain.mjs",
    "governance:verify": "node scripts/verify-governance-onchain.mjs",
    "kycport:verify-config": "node scripts/verify-kycport-config.mjs",
    "payhub:anchor-onchain": "cd contracts && npx hardhat run scripts/anchor-payhub-onchain.cjs --network sidra",
    "protocol:audit:sc-gat": "cd contracts && npm run audit:sc-gat"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/qrcode": "^1.5.6",
    "@vercel/functions": "^3.6.1",
    "@vercel/node": "^5.8.4",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "^15.18.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.12",
